# Copy this file to .env before starting Docker Compose. Do not commit real secrets.
APP_ENV=dev
LOG_LEVEL=INFO

# Public entry point
GATEWAY_HTTP_PORT=8080
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=dev

# Local infrastructure. Replace every value before deploying outside a local machine.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=change-me-local-only
CONSUL_PORT=8500

# 本地开发默认留空，user-service 与 gateway-auth 会共同使用 HS256 降级模式。
# 如需启用 RS256，可运行 `uv run --project backend python backend/scripts/generate_secrets.py`，
# 脚本会生成 RSA 密钥对并将两个 PEM 值写入 `.env`。
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INTERNAL_TOKEN=replace-with-internal-service-token

# Optional observability profile ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
JAEGER_UI_PORT=16686
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
